---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

const project = projects.find(
  (project) => project.link === "/work/prompt-guide",
);

if (!project) {
  throw new Error("Project not found");
}
---

<Layout>
  <main>
    <article class="project-page">
      <a class="back-link" href="/">← Back to portfolio</a>

      <header class="project-header">
        <p class="project-label">
          Technical Communication · Individual Project
        </p>
        <h1>{project?.title}</h1>

        <p class="project-intro">
          {project?.description}
        </p>
        <a
          class="button"
          href="/files/ptw310_prompt_guide_final.docx"
          target="_blank"
          rel="noopener noreferrer"
        >
          View final guide
        </a>
      </header>

      <section>
        <h2>The Challenge</h2>
        <p>CONTENT TBD</p>
      </section>

      <section>
        <h2>My Role</h2>
        <p>CONTENT TBD</p>
      </section>

      <section>
        <h2>Audience</h2>
        <p>CONTENT TBD</p>
      </section>

      <section>
        <h2>Approach</h2>
        <p>CONTENT TBD</p>
      </section>

      <section>
        <h2>Result</h2>
        <p>CONTENT TBD</p>
      </section>
    </article>
  </main>
</Layout>
