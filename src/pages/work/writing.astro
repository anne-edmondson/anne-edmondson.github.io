---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main>
    <header class="project-header">
      <a class="back-link" href="/">← Back to Portfolio</a>
      <h1>Writing Samples</h1>
      <p class="project-intro">
        Selected technical communication work demonstrating content strategy, audience-centered thinking, and professional growth.
      </p>
    </header>
    <section class="writing-list">
      <article>
        <h2>Content Strategy Statement: Denver Art Museum (DAM)</h2>
        <p>
          A fictional content strategy statement reflecting DAM's commitment
          to spurring curiosity and making art and creativity accessible to diverse audiences.
        </p>
        <a
          href="/files/content-strategy-DAM.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Sample
        </a>
      </article>
      <article>
        <h2>Personal Retrospective -Technical Writing Program</h2>
        <p>
          A personal retrospective on the knowledge and skills developed through the University of Washington Professional Technical Writing program.
        </p>
        <a
          href="/files/ptw-program-retro.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          View Sample
        </a>
      </article>
    </section>
  </main>
</Layout>
