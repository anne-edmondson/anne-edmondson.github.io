---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

const project = projects.find(
  (project) => project.link === "/work/linkedin-tips",
);

if (!project) {
  throw new Error("Project not found");
}
---

<Layout>
  <main>
    <article class="project-page">
      <a class="back-link" href="/">← Back to portfolio</a>

      <header class="project-header">
        <p class="project-label">
          Instructional Guide · Career Development · Collaborative Project
        </p>
        <h1>{project?.title}</h1>

        <p class="project-intro">
          {project?.description}
        </p>
        <div class="project-resources">
          <a
            class="button"
            href="/files/linkedin-profile-tips.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Final Deliverable
          </a>
          <a
            class="button button-secondary"
            href="/files/linkedin-project-plan.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Project Plan
          </a>
          <a
            class="button button-secondary"
            href="/files/linkedin-project-presentation.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Project Presentation
          </a>
        </div>
      </header>

      <section>
        <h2>The Challenge</h2>
        <p>
          New technical writers need more than a complete LinkedIn profile; they
          need a profile that clearly communicates their professional value. Our
          challenge was to create practical instructional content that would
          help users showcase their skills and experience, strengthen their
          professional presence, and attract recruiters and prospective
          employers.
        </p>
      </section>

      <section>
        <h2>My Role</h2>
        <p>
          I served as production specialist for this collaborative project, designing the final instructional guide and project presentation.
        </p>
      </section>

      <section>
        <h2>Audience</h2>
        <p>
          The primary audience was new technical writers who wanted to create or
          improve a professional LinkedIn profile. Our analysis identified users
          who were unfamiliar or uncomfortable with LinkedIn, had never used it,
          or were not using the platform to its full professional potential.
        </p>
      </section>

      <section>
        <h2>Approach</h2>
        <p>
          Our team identified the audience’s highest-priority tasks, including
          developing an effective About statement, highlighting relevant
          experience and education, showcasing skills, and creating an effective
          introduction. I used the resulting content and research to design a
          three-page guide with numbered tips, visual callouts, icons, and
          annotated LinkedIn profile examples that make the information easy to
          scan and apply.
        </p>
      </section>

      <section>
        <h2>Result</h2>
        <p>
          The final deliverable is a concise, visually structured guide that
          gives new technical writers practical steps for strengthening their
          LinkedIn profiles. It combines short instructional sections with
          visual examples so readers can quickly identify improvements and apply
          them to their own profiles.
        </p>
      </section>
    </article>
  </main>
</Layout>
