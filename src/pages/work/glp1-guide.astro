---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

const project = projects.find((project) => project.link === "/work/glp1-guide");
---

<Layout>
  <main>
    <article class="project-page">
      <a class="back-link" href="/">← Back to portfolio</a>

      <header class="project-header">
        <p class="project-label">
          Technical Communication · Collaborative Project
        </p>
        <h1>{project?.title}</h1>

        <p class="project-intro">
          {project?.description}
        </p>
        <a
          class="button"
          href="/files/ptw330_glp1_trifold.pdf"
          target="_blank"
          rel="noopener noreferrer"
        >
          View final guide
        </a>
      </header>

      <section>
        <h2>The Challenge</h2>
        <p>
          Create a clear, approachable guide that helps adult readers understand
          GLP-1 medications without overwhelming them with complex medical
          information.
        </p>
      </section>

      <section>
        <h2>My Role</h2>
        <p>
          I served as editor and production specialist, helping shape the
          content, improve consistency and readability, and prepare the final
          guide for delivery.
        </p>
      </section>

      <section>
        <h2>Audience</h2>
        <p>
          The guide was designed for adults who needed accessible, practical
          information to help them understand GLP-1 medications and make
          informed decisions.
        </p>
      </section>

      <section>
        <h2>Approach</h2>
        <p>
          The team used audience analysis, plain-language principles,
          collaborative writing and editing, and iterative review to organize
          complex information into a usable guide.
        </p>
      </section>

      <section>
        <h2>Result</h2>
        <p>
          The final deliverable combined clear explanations, intentional
          information structure, and reader-focused design into a practical
          medication guide.
        </p>
      </section>
    </article>
  </main>
</Layout>
