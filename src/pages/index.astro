---
//LAYOUT
import Layout from "../layouts/Layout.astro";

//COMPONENTS
import CapabilityCard from "../components/CapabilityCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

//DATA
import {
  technicalCommunication,
  businessAnalysis,
  technicalFluency,
} from "../data/capabilities";
import { projects } from "../data/projects";
---

<Layout>
  <main>
    <section class="hero">
      <h1>
        I bring clarity to complex information so people can get things done.
      </h1>

      <p>
        I combine technical communication, business analysis, and hands-on
        technology experience to understand audiences, collaborate across teams,
        and create content that works.
      </p>

      <div class="hero-actions">
        <a class="button" href="#work">Explore my work</a>
        <a class="text-link" href="/resume.pdf">View résumé</a>
      </div>
    </section>

    <section>
      <h2>Core Capabilities</h2>

      <div class="capability-grid">
        <CapabilityCard
          title="Technical Communication"
          capabilities={technicalCommunication}
        />
        <CapabilityCard
          title="Business Analysis"
          capabilities={businessAnalysis}
        />
        <CapabilityCard
          title="Technical Fluency"
          capabilities={technicalFluency}
        />
      </div>
    </section>

    <section id="work">
      <h2>Selected Work</h2>
      <div class="project-grid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              thumbnail={project.thumbnail}
              link={project.link}
            />
          ))
        }
      </div>
    </section>

    <section>
      <h2>Featured Technical Communication</h2>

      <div class="writing-list">
        <article>
          <h3>Art Museum Information Architecture</h3>
          <p>
            Information architecture exercise focused on organizing content and
            improving how users find and understand information.
          </p>
          <a href="#">View sample</a>
        </article>

        <article>
          <h3>Audience Analysis</h3>
          <p>
            Audience analysis developed for a collaborative technical writing
            project to guide content, tone, structure, and usability decisions.
          </p>
          <a href="#">View sample</a>
        </article>
      </div>
    </section>

    <section>
      <h2>How I Work</h2>

      <div class="how-i-work-grid">
        <article>
          <h3>Start with the audience</h3>
          <p>
            I begin by understanding what people need to know, do, or decide, then
            shape the content, structure, and level of detail around those needs.
          </p>
        </article>

        <article>
          <h3>Use AI deliberately</h3>
          <p>
            I use generative AI to accelerate research, drafting, coding, and
            iteration while keeping human judgment, verification, and final
            decisions in the loop.
          </p>
        </article>

        <article>
          <h3>Work iteratively</h3>
          <p>
            I break complex work into manageable pieces, make progress visible,
            gather feedback, and improve as I go—whether I’m working on a product
            team or using a personal Kanban board in my kitchen.
          </p>
        </article>
      </div>
    </section>
  </main>
</Layout>
