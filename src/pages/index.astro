---
//LAYOUT
import Layout from "../layouts/Layout.astro";

//COMPONENTS
import CapabilityCard from "../components/CapabilityCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

//DATA
import {
  technicalCommunication,
  businessAnalysis,
  technicalFluency,
} from "../data/capabilities";
import { projects } from "../data/projects";
---

<Layout>
  <main id="home">
    <section class="hero">
      <h1>
        I bring clarity to complex information so people can get things done.
      </h1>
      <p>
        I combine technical communication, business analysis, and hands-on
        technology experience to understand audiences, collaborate across teams,
        and create clear content that helps users accomplish tasks.
      </p>

      <div class="hero-actions">
        <a class="button" href="#projects">Explore My Projects</a>
        <a class="text-link" href="/files/aee_resume_2026.pdf">View My Résumé</a
        >
      </div>
    </section>

    <section>
      <h2>Core Capabilities</h2>

      <div class="capability-grid">
        <CapabilityCard
          title="Technical Communication"
          capabilities={technicalCommunication}
        />
        <CapabilityCard
          title="Business Analysis"
          capabilities={businessAnalysis}
        />
        <CapabilityCard
          title="Technical Fluency"
          capabilities={technicalFluency}
        />
      </div>
    </section>

    <section id="projects">
      <h2>Selected Projects</h2>
      <div class="project-grid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              thumbnail={project.thumbnail}
              link={project.link}
            />
          ))
        }
      </div>
    </section>

    <section id="how-i-work">
      <h2>How I Work</h2>

      <div class="how-i-work-grid">
        <article>
          <h3>Audience-Centered Analysis</h3>
          <p>
            I begin by understanding what people need to know, do, or decide,
            then shape the content, structure, and level of detail around those
            needs.
          </p>
        </article>

        <article>
          <h3>Intentional Use of AI</h3>
          <p>
            I regularly use generative AI to accelerate user research, outline
            documents, and assist with code. I always rely on human judgment and
            verification for final decision-making.
          </p>
        </article>

        <article>
          <h3>Agile for All Things</h3>
          <p>
            I break complex work into manageable pieces, visibly track progress,
            and improve as I go whether I’m working on a product team or nerding
            out with the personal Kanban board in my kitchen.
          </p>
        </article>
      </div>
    </section>
    <section id="about" class="about">
      <h2>About</h2>
      <p>
        My background spans technical communication, business analysis, and web
        technology. Across those roles, the common thread has been understanding
        what people need, untangling complex information, and turning it into
        something clear and useful.
      </p>
      <p>
        I bring curiosity, collaborative problem solving, and a thoughtful,
        enthusiastic approach to new technologies, including generative AI. I
        care about intuitive user experiences, clear communication, and creating
        content people can understand and use.
      </p>
    </section>
  </main>
</Layout>
