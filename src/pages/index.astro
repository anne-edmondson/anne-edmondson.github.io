---
import Layout from "../layouts/Layout.astro";
import CapabilityCard from "../components/CapabilityCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

const technicalCommunication = [
  "Technical writing and editing",
  "Audience analysis",
  "Content strategy",
  "Information architecture",
  "Accessibility and usability",
];

const businessAnalysis = [
  "Requirements elicitation and documentation",
  "Process improvement",
  "Stakeholder collaboration",
  "User stories and acceptance criteria",
  "Agile and AI-empowered SAFe practices",
];

const technicalFluency = [
  "Front-end web development",
  "Agentic and generative AI Python programming",
  "CMS content migration, documentation, and stakeholder training",
  "Knowledge base creation and maintenance",
  "Markdown",
  "Docs-as-code",
];

const projects = [
  {
    title: "GLP-1 Medication Guide",
    description:
      "A plain-language guide designed to help adults understand GLP-1 medications and make informed decisions.",
    thumbnail: "/images/glp1-guide.png",
    link: "/work/glp1-guide",
  },
  {
    title: "Prompt Engineering for Non-Developers",
    description:
      "Non-technical, instructional guide for getting better responses from Generative AI platforms.",
    thumbnail: "/images/prompt-guide.png",
    link: "/work/prompt-guide",
  },
];
---

<Layout>
  <main>
    <section>
      <h1>
        I bring clarity to complex information so people can get things done.
      </h1>

      <p>
        I combine technical communication, business analysis, and hands-on
        technology experience to understand audiences, collaborate across teams,
        and create content that works.
      </p>

      <a href="#work">Explore my work</a>
      <a href="/resume.pdf">View résumé</a>
    </section>

    <section>
      <h2>Core Capabilities</h2>
      <CapabilityCard
        title="Technical Communication"
        capabilities={technicalCommunication}
      />
      <CapabilityCard
        title="Business Analysis"
        capabilities={businessAnalysis}
      />
      <CapabilityCard
        title="Technical Fluency"
        capabilities={technicalFluency}
      />
    </section>

    <section id="work">
      <h2>Selected Work</h2>
      {
        projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            thumbnail={project.thumbnail}
            link={project.link}
          />
        ))
      }
    </section>

    <section>
      <h2>Featured Writing</h2>
    </section>

    <section>
      <h2>How I Work</h2>
    </section>
  </main>
</Layout>
