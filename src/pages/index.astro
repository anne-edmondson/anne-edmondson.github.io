---
//LAYOUT
import Layout from "../layouts/Layout.astro";

//COMPONENTS
import CapabilityCard from "../components/CapabilityCard.astro";
import ProjectCard from "../components/ProjectCard.astro";

//DATA
import {
  technicalCommunication,
  businessAnalysis,
  technicalFluency,
} from "../data/capabilities";
import { projects } from "../data/projects";
---

<Layout>
  <main>
    <section>
      <h1>
        I bring clarity to complex information so people can get things done.
      </h1>

      <p>
        I combine technical communication, business analysis, and hands-on
        technology experience to understand audiences, collaborate across teams,
        and create content that works.
      </p>

      <a href="#work">Explore my work</a>
      <a href="/resume.pdf">View résumé</a>
    </section>

    <section>
      <h2>Core Capabilities</h2>
      <CapabilityCard
        title="Technical Communication"
        capabilities={technicalCommunication}
      />
      <CapabilityCard
        title="Business Analysis"
        capabilities={businessAnalysis}
      />
      <CapabilityCard
        title="Technical Fluency"
        capabilities={technicalFluency}
      />
    </section>

    <section id="work">
      <h2>Selected Work</h2>
      <div class="project-grid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              thumbnail={project.thumbnail}
              link={project.link}
            />
          ))
        }
      </div>
    </section>

    <section>
      <h2>Featured Writing</h2>
    </section>

    <section>
      <h2>How I Work</h2>
    </section>
  </main>
</Layout>
